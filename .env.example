# --- Clave de MiniMax (obligatoria) ---
# Consíguela en https://platform.minimax.io/user-center/basic-information/interface-key
# En local, copia este archivo a .env.local
# En Vercel, va en Settings -> Environment Variables (nunca en el repositorio)
MINIMAX_API_KEY=pon-aqui-tu-clave

# --- Opcional: ajustes del proveedor ---
# Cuenta internacional: https://api.minimax.io/v1
# Cuenta de China continental: https://api.minimaxi.com/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Modelo para textos escritos.
MINIMAX_MODELO_TEXTO=MiniMax-M2.7

# Modelo para fotos: tiene que aceptar imágenes.
MINIMAX_MODELO_VISION=MiniMax-M3

# Tiempo máximo de espera al modelo, en milisegundos.
# Tiene que ser menor que el maxDuration de la función en Vercel.
MINIMAX_TIMEOUT_MS=55000

# Peticiones por minuto y por IP.
LIMITE_POR_MINUTO=20
