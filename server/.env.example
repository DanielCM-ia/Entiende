# --- Clave de MiniMax (obligatoria) ---
# Consíguela en https://platform.minimax.io/user-center/basic-information/interface-key
MINIMAX_API_KEY=pon-aqui-tu-clave

# --- Opcional: ajustes del proveedor ---
# Base de la API. Cuenta internacional: https://api.minimax.io/v1
# Cuenta de China continental: https://api.minimaxi.com/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Modelo para textos. MiniMax-M2.7-highspeed es más barato y rápido.
MINIMAX_MODELO_TEXTO=MiniMax-M2.7

# Modelo para fotos: tiene que aceptar imágenes. MiniMax-M3 es multimodal.
MINIMAX_MODELO_VISION=MiniMax-M3

# --- Servidor ---
PORT=3001

# Orígenes permitidos para el navegador, separados por comas.
# En desarrollo, Vite sirve la web en el 5173.
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Peticiones por minuto y por IP.
LIMITE_POR_MINUTO=20
